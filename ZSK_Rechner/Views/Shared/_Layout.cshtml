<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ZSK-Rechner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="zsk-header">
        <div class="zsk-container header-inner d-flex align-items-center justify-content-between">
            <a class="brand d-flex align-items-center gap-3" asp-controller="Home" asp-action="Index" aria-label="ZSK-Rechner Startseite">
                <img class="brand-logo" src="~/images/logo-zsk.jpg" asp-append-version="true" alt="Logo der Ziegen-Schafe-Kuh GmbH &amp; Co. KG" />
                <span class="brand-copy">
                    <span class="brand-title">ZSK-RECHNER</span>
                    <span class="brand-subtitle">Tierisch gute Zahlen</span>
                </span>
            </a>

            <nav class="zsk-nav d-flex align-items-center" aria-label="Hauptnavigation">
                <a class="nav-item active" asp-controller="Home" asp-action="Index">Startseite</a>
                <a class="nav-item" asp-controller="Home" asp-action="Index" asp-fragment="rechner">Rechner</a>
                <a class="nav-item" asp-controller="Home" asp-action="Index" asp-fragment="wechselkurse">Wechselkurse</a>
                <a class="nav-item" asp-controller="Home" asp-action="Index" asp-fragment="tierverwaltung">Tierverwaltung</a>
            </nav>

            <a class="header-cta d-inline-flex align-items-center" asp-controller="Home" asp-action="Index" asp-fragment="rechner">
                Rechner öffnen
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="zsk-footer">
        <div class="zsk-container footer-inner d-flex align-items-center justify-content-between">
            <strong>Ziegen-Schafe-Kuh GmbH &amp; Co. KG</strong>
            <span>Social-Media-Abenteuer für Tiere mit Personality.</span>
            <span>© 2026 ZSK</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
