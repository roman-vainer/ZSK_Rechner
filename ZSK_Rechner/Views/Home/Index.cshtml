@model ZSK_Rechner.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Startseite";
}

<section class="hero-section">
    <div class="hero-grain" aria-hidden="true"></div>
    <div class="zsk-container hero-inner row align-items-center g-0">
        <div class="hero-copy col-6">
            <div class="eyebrow">
                <span class="eyebrow-dot"></span>
                Social-Media-Erfolg neu gerechnet
            </div>

            <h1 class="hero-title">
                Willkommen beim
                <span>ZSK-Rechner.</span>
            </h1>

            <p class="hero-lead">
                Bei uns wird Social Media tierisch ernst genommen – wir messen Erfolg nicht nur in Likes,
                sondern in <strong>Ziegen, Schafen und Kühen.</strong>
            </p>

            <div class="hero-actions d-flex flex-wrap">
                <a class="zsk-button button-primary" asp-controller="Calculate" asp-action="Index" asp-fragment="rechner">
                    Zum Rechner
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9" /></svg>
                </a>
                <a class="zsk-button button-secondary" asp-controller="Animal" asp-action="Index" asp-fragment="tierverwaltung">
                    Zur Tierverwaltung
                </a>
            </div>

            <div class="animal-note d-flex align-items-center">
                <span class="animal-chips d-flex" aria-hidden="true">
                    <span class="animal-chip chip-orange">Z</span>
                    <span class="animal-chip chip-beige">S</span>
                    <span class="animal-chip chip-teal">K</span>
                </span>
                <span>Tierarten flexibel verwalten</span>
            </div>
        </div>

        <div class="hero-art col-6">
            <div class="orbit orbit-large" aria-hidden="true"></div>
            <div class="orbit orbit-small" aria-hidden="true"></div>
            <div class="logo-stage">
                <span class="original-label">Original seit heute</span>
                <img src="~/images/logo-zsk.jpg" asp-append-version="true" alt="Ziegen-Schafe-Kuh GmbH &amp; Co. KG – Kuhfluencer-Management" />
            </div>

            <div class="rate-card">
                <span class="rate-label">Beispielkurs</span>
                <div class="rate-value d-flex align-items-end">
                    <strong>1 Kuh</strong>
                    
                    <span>= @Model.CowRate €</span>
                </div>
            </div>

            <div class="quality-badge">100 %<br />tierisch</div>
        </div>
    </div>
</section>

<section class="feature-section" id="rechner">
    <div class="zsk-container">
        <div class="feature-heading d-flex align-items-end justify-content-between">
            <div>
                <p class="section-kicker">Was der ZSK-Rechner kann</p>
                <h2>Zahlen, die jeder versteht.</h2>
            </div>
            <p class="feature-intro">
                Praktische Werkzeuge für alle, die Social-Media-Leistung lieber mit Charakter betrachten.
            </p>
        </div>

        <div class="feature-grid">
            <article class="feature-card feature-orange">
                <div class="card-top d-flex align-items-start justify-content-between">
                    <span class="feature-icon">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="3" /><path d="M8.5 7h7M9 12h.01M15 12h.01M9 16h.01M15 16h.01" /></svg>
                    </span>
                    <span class="card-number">01</span>
                </div>
                <h3>Umrechnung</h3>
                <p>Tiere in Euro und Euro in Tiere umrechnen.</p>
            </article>

            <article class="feature-card feature-teal" id="tierverwaltung">
                <div class="card-top d-flex align-items-start justify-content-between">
                    <span class="feature-icon">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v10H4V10Z" /><path d="M9 20v-6h6v6M8 10h8" /></svg>
                    </span>
                    <span class="card-number">02</span>
                </div>
                <h3>Tierverwaltung</h3>
                <p>Tierarten hinzufügen, bearbeiten und löschen.</p>
            </article>

            <article class="feature-card feature-cream" id="wechselkurse">
                <div class="card-top d-flex align-items-start justify-content-between">
                    <span class="feature-icon">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 17 10 11l4 4 6-8" /><path d="M15 7h5v5" /></svg>
                    </span>
                    <span class="card-number">03</span>
                </div>
                <h3>Wechselkurse</h3>
                <p>Aktuelle Tierwerte und ihre Kursentwicklung einsehen.</p>
            </article>
        </div>
    </div>
</section>
