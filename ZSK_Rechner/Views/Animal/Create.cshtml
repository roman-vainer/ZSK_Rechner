@model AnimalCreateViewModel

<div class="modal fade" id="animalFormModal" tabindex="-1" aria-labelledby="animalFormModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content animal-modal">
            <div class="modal-header">
                <div>
                    <p class="section-kicker modal-kicker">Neue Tierart</p>
                    <h2 class="modal-title" id="animalFormModalTitle">Neues Tier hinzufügen</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Dialog schließen"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="animalName">Tiername</label>
                        <input class="form-control" id="animalName" name="Name" type="text" placeholder="z. B. Alpaka" required />
                    </div>
                    <div>
                        <label class="form-label" for="exchangeRate">Wechselkurs (€)</label>
                        <input class="form-control" id="exchangeRate" name="ExchangeRate" type="number" min="0.01" step="0.01" placeholder="0,00" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="zsk-button button-secondary" data-bs-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="zsk-button button-primary" id="animalSubmitButton">Speichern</button>
                </div>
            </form>
        </div>
    </div>
</div>