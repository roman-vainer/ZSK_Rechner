@model List<ZSK_Rechner.ViewModels.AnimalViewModel>
@{
	ViewData["Title"] = "Tierverwaltung";
}

@section Styles {
	<link rel="stylesheet" href="~/css/animal.css" asp-append-version="true" />
}

<section class="animal-page">
	<div class="zsk-container">
		<header class="animal-page-heading d-flex align-items-end justify-content-between">
			<div>
				<p class="section-kicker">Bestand &amp; Kurse</p>
				<h1>Tierverwaltung</h1>
				<p class="page-subtitle">Tierarten und aktuelle Wechselkurse verwalten.</p>
			</div>
			<a class="zsk-button button-primary" asp-controller="Animal" asp-action="Create">
				<span aria-hidden="true">+</span>
				Neues Tier hinzufügen
			</a>
		</header>
		<section class="animal-table-card" aria-labelledby="animal-table-title">
			<div class="animal-table-heading d-flex align-items-center justify-content-between">
				<div>
					<h2 id="animal-table-title">Tierarten</h2>
					<p>Alle hinterlegten Tiere und ihre aktuellen Euro-Werte.</p>
				</div>
				<span class="animal-count">@Model.Count() Einträge</span>
			</div>

			<div class="table-responsive">
				<table class="table animal-table align-middle mb-0">
					<thead>
						<tr>
							<th scope="col">Tierart</th>
							<th scope="col">Aktueller Kurs (€)</th>
							<th scope="col" class="text-end">Aktionen</th>
						</tr>
					</thead>
					<tbody>

						@{
							string[] colors = { "avatar-terracotta", "avatar-beige", "avatar-teal" };
							int index = 0;
						}

						@foreach (var animal in Model)
						{
							string avatarClass = colors[index % colors.Length];
							<tr>
								<td>
									<span class="animal-avatar @avatarClass">@animal.AnimalName[0]</span><strong>@animal.AnimalName</strong>
								</td>
								<td class="animal-rate">@(animal.Rate.HasValue? $"{animal.Rate!.Value:N2} €" : "-")</td>

								<td>
									<div class="d-flex justify-content-end gap-2">
										<a class="btn animal-action edit-action" asp-controller="Animal" asp-action="Edit" asp-route-id=@animal.AnimalId>Bearbeiten</a>
										<form asp-controller="Animal" asp-action="Delete" asp-route-id=@animal.AnimalId method="post"
											  onsubmit="return confirm('Möchten Sie dieses Tier wirklich löschen?');">
											<button type="submit" class="btn animal-action delete-action">Löschen</button>
										</form>
									</div>
								</td>
							</tr>
							index++;
						}
					</tbody>
				</table>
			</div>
		</section>
	</div>
</section>