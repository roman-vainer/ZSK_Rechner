@section Scripts {
    <script>
        (() => {
            const formModal = document.getElementById("animalFormModal");
            const deleteModal = document.getElementById("deleteAnimalModal");

            formModal.addEventListener("show.bs.modal", event => {
                const trigger = event.relatedTarget;
                const isEdit = trigger.dataset.mode === "edit";
                formModal.querySelector(".modal-kicker").textContent = isEdit ? "Tierart aktualisieren" : "Neue Tierart";
                formModal.querySelector(".modal-title").textContent = isEdit ? "Tier bearbeiten" : "Neues Tier hinzufügen";
                formModal.querySelector("#animalSubmitButton").textContent = isEdit ? "Änderungen speichern" : "Speichern";
                formModal.querySelector("#animalName").value = isEdit ? trigger.dataset.name : "";
                formModal.querySelector("#exchangeRate").value = isEdit ? trigger.dataset.rate : "";
            });

            deleteModal.addEventListener("show.bs.modal", event => {
                const name = event.relatedTarget.dataset.name;
                deleteModal.querySelector("#deleteAnimalName").textContent = name;
                deleteModal.querySelector("#deleteAnimalInput").value = name;
            });
        })();
    </script>
