@{
    ViewData["Title"] = "Tierverwaltung";
}

@section Styles {
    <link rel="stylesheet" href="~/css/animal.css" asp-append-version="true" />
}

<section class="animal-page">
    <div class="zsk-container">
        <header class="animal-page-heading d-flex align-items-end justify-content-between">
            <div>
                <p class="section-kicker">Bestand &amp; Kurse</p>
                <h1>Tierverwaltung</h1>
                <p class="page-subtitle">Tierarten und aktuelle Wechselkurse verwalten.</p>
            </div>
            <a class="zsk-button button-primary" asp-controller="Animal" asp-action="Create">
                <span aria-hidden="true">+</span>
                Neues Tier hinzufügen
            </a>
        </header>
        <section class="animal-table-card" aria-labelledby="animal-table-title">
            <div class="animal-table-heading d-flex align-items-center justify-content-between">
                <div>
                    <h2 id="animal-table-title">Tierarten</h2>
                    <p>Alle hinterlegten Tiere und ihre aktuellen Euro-Werte.</p>
                </div>
                <span class="animal-count">4 Einträge</span>
            </div>

            <div class="table-responsive">
                <table class="table animal-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Tierart</th>
                            <th scope="col">Aktueller Kurs (€)</th>
                            <th scope="col" class="text-end">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="animal-avatar avatar-terracotta">K</span><strong>Kuh</strong></td>
                            <td class="animal-rate">2.800,00 €</td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn animal-action edit-action" type="button" data-bs-toggle="modal" data-bs-target="#animalFormModal" data-mode="edit" data-name="Kuh" data-rate="2800.00">Bearbeiten</button>
                                    <button class="btn animal-action delete-action" type="button" data-bs-toggle="modal" data-bs-target="#deleteAnimalModal" data-name="Kuh">Löschen</button>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="animal-avatar avatar-beige">S</span><strong>Schaf</strong></td>
                            <td class="animal-rate">650,00 €</td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn animal-action edit-action" type="button" data-bs-toggle="modal" data-bs-target="#animalFormModal" data-mode="edit" data-name="Schaf" data-rate="650.00">Bearbeiten</button>
                                    <button class="btn animal-action delete-action" type="button" data-bs-toggle="modal" data-bs-target="#deleteAnimalModal" data-name="Schaf">Löschen</button>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="animal-avatar avatar-teal">Z</span><strong>Ziege</strong></td>
                            <td class="animal-rate">500,00 €</td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn animal-action edit-action" type="button" data-bs-toggle="modal" data-bs-target="#animalFormModal" data-mode="edit" data-name="Ziege" data-rate="500.00">Bearbeiten</button>
                                    <button class="btn animal-action delete-action" type="button" data-bs-toggle="modal" data-bs-target="#deleteAnimalModal" data-name="Ziege">Löschen</button>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="animal-avatar avatar-terracotta">K</span><strong>Kleine Ziege</strong></td>
                            <td class="animal-rate">50,00 €</td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn animal-action edit-action" type="button" data-bs-toggle="modal" data-bs-target="#animalFormModal" data-mode="edit" data-name="Kleine Ziege" data-rate="50.00">Bearbeiten</button>
                                    <button class="btn animal-action delete-action" type="button" data-bs-toggle="modal" data-bs-target="#deleteAnimalModal" data-name="Kleine Ziege">Löschen</button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</section>



