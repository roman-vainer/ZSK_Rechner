@model ZSK_Rechner.ViewModels.CalculateViewModel
@{
	ViewData["Title"] = "Rechner";
}

@section Styles {
	<link rel="stylesheet" href="~/css/animal.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/calculate.css" asp-append-version="true" />
}

<section class="animal-page calculate-page">
	<div class="zsk-container">
		<header class="animal-page-heading">
			<div>
				<p class="section-kicker">Tierische Werte</p>
				<h1>Rechner</h1>
				<p class="page-subtitle">Tierwerte einfach in Euro umrechnen – und umgekehrt.</p>
			</div>
		</header>

		<div class="row g-4 calculate-grid">
			<div class="col-7">
				<section class="animal-table-card calculate-card h-100" aria-labelledby="conversion-title">
					<div class="animal-table-heading">
						<div>
							<h2 id="conversion-title">Umrechnung</h2>
							<p>Wählen Sie Richtung, Tierart und den gewünschten Wert.</p>
						</div>
					</div>

					<form asp-controller="Calculate" asp-action="Index" method="post" class="calculate-form">
						<div class="mb-3">
							<label class="form-label" asp-for="Direction">Umrechnungsrichtung</label>
							<select class="form-select" asp-for="Direction">
								<option value="AnimalToEuro">Tiere → Euro</option>
								<option value="EuroToAnimal">Euro → Tiere</option>
							</select>
						</div>

						<div class="mb-3">
							<label class="form-label" asp-for="AnimalId">Tierart</label>
							<select class="form-select" asp-for="AnimalId" required>
								<option value="">Tierart auswählen</option>
								@foreach (var animal in Model.Animals)
								{
									<option value="@animal.Id">@animal.Name</option>
								}
							</select>
						</div>

						<div class="mb-4">
							<label class="form-label" asp-for="Value">Menge / Betrag</label>
							<input class="form-control"
								   asp-for="Value"
								   type="number"
								   min="0.01"
								   step="0.01"
								   inputmode="decimal"
								   placeholder="0,00"
								   required />
							<span asp-validation-for="Value" class="text-danger"></span>
						</div>

						<button class="zsk-button button-primary" type="submit">Berechnen</button>
					</form>
				</section>
			</div>

			<div class="col-5">
				<section class="animal-table-card calculate-card result-card h-100" aria-labelledby="result-title">
					<div class="animal-table-heading">
						<div>
							<h2 id="result-title">Ergebnis</h2>
							<p>Ihre Umrechnung erscheint nach dem Berechnen hier.</p>
						</div>
					</div>

					<div class="result-content">

						@if (Model.Result.HasValue)
						{
							<dl class="result-values">
								<div>
									<dt>Berechnetes Ergebnis</dt>
									<dd>@Model.Result</dd>
								</div>
								<div>
									<dt>Angewandter Wechselkurs</dt>
									<dd>@Model.AppliedRate</dd>
								</div>
							</dl>
						}
						else
						{
							<p class="result-empty">Noch keine Berechnung durchgeführt.</p>
						}
					</div>
				</section>
			</div>
		</div>
	</div>
</section>